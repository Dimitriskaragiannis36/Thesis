\@writefile{lof}{\contentsline {figure}{\numberline {42}{\ignorespaces Πρωτόκολλο επικοινωνίας που ακολουθείται στη υλοποίηση σωλήνωσης κατά μπλοκ σκακιέρας του αλγορίθμου του \foreignlanguage  {english}{Floyd}. Υποθέτουμε ότι ο επεξεργαστής 4 τη χρονική στιγμή $t$ έχει μόλις υπολογίσει ένα τμήμα της $k$-οστής στήλης του πίνακα $D^{(k-1)}$. Το αποστέλλει στους επεξεργαστές 3 και 5. Αυτοί οι επεξεργαστές λαμβάνουν το τμήμα τη χρονική στιγμή $t+1$ (όπου η μονάδα χρόνου είναι ο χρόνος που χρειάζεται ένα τμήμα πίνακα για να διανύσει τη ζεύξη επικοινωνίας μεταξύ γειτονικών επεξεργαστών). Ομοίως, οι επεξεργαστές που απέχουν περισσότερο από τον επεξεργαστή 4 λαμβάνουν το τμήμα αργότερα. Ο επεξεργαστής 1 (στο όριο του πλέγματος) δεν προωθεί τo τμήμα μετά την παραλαβή του.}}{73}{figure.caption.75}\protected@file@percent }
\newlabel{fig:graph11}{{42}{73}{Πρωτόκολλο επικοινωνίας που ακολουθείται στη υλοποίηση σωλήνωσης κατά μπλοκ σκακιέρας του αλγορίθμου του \foreignlanguage {english}{Floyd}. Υποθέτουμε ότι ο επεξεργαστής 4 τη χρονική στιγμή $t$ έχει μόλις υπολογίσει ένα τμήμα της $k$-οστής στήλης του πίνακα $D^{(k-1)}$. Το αποστέλλει στους επεξεργαστές 3 και 5. Αυτοί οι επεξεργαστές λαμβάνουν το τμήμα τη χρονική στιγμή $t+1$ (όπου η μονάδα χρόνου είναι ο χρόνος που χρειάζεται ένα τμήμα πίνακα για να διανύσει τη ζεύξη επικοινωνίας μεταξύ γειτονικών επεξεργαστών). Ομοίως, οι επεξεργαστές που απέχουν περισσότερο από τον επεξεργαστή 4 λαμβάνουν το τμήμα αργότερα. Ο επεξεργαστής 1 (στο όριο του πλέγματος) δεν προωθεί τo τμήμα μετά την παραλαβή του}{figure.caption.75}{}}
\newlabel{eq:relation10}{{12}{74}{Επιτάχυνση των Πραγμάτων}{equation.12}{}}
